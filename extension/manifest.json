{
  "manifest_version": 2,
  "name": "Burrow",
  "version": "2.4.0",
  "description": "Remembers the path out of a rabbit hole: tabs you open from a page become prerequisites of it in Burrow, with a breadcrumb on every page.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "tabs",
    "webNavigation",
    "sessions",
    "storage",
    "tabHide",
    "contextMenus",
    "notifications",
    "<all_urls>",
    "http://127.0.0.1/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["palette-ui.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_title": "Burrow",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "sidebar_action": {
    "default_title": "Burrow",
    "default_panel": "sidebar.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" },
    "open_at_install": false
  },
  "omnibox": { "keyword": "bw" },
  "options_ui": {
    "page": "options.html",
    "browser_style": false
  },
  "commands": {
    "capture-page": {
      "suggested_key": { "default": "Alt+Shift+B" },
      "description": "Add this page to Burrow"
    },
    "select-card": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Make a card from the selected words (nothing opens)"
    },
    "notes": {
      "suggested_key": { "default": "Alt+Shift+N" },
      "description": "Open this tab's card and its notes in Burrow"
    },
    "done": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Understood: close this tab and go to the next one"
    },
    "up": {
      "suggested_key": { "default": "Alt+Shift+U" },
      "description": "Up to the card that needs this one"
    },
    "unrelated": {
      "suggested_key": { "default": "Alt+Shift+X" },
      "description": "Not related: remove this page's card from the map"
    },
    "palette": {
      "suggested_key": { "default": "Alt+Shift+K" },
      "description": "Burrow palette: jump to a card, make one, run a command"
    },
    "_execute_sidebar_action": {
      "suggested_key": { "default": "Alt+Shift+O" },
      "description": "Show or hide the Burrow outline"
    },
    "undo": {
      "suggested_key": { "default": "Alt+Shift+Z" },
      "description": "Undo the last Burrow change"
    },
    "redo": {
      "suggested_key": { "default": "Alt+Shift+Y" },
      "description": "Redo"
    },
    "toggle-breadcrumb": {
      "suggested_key": { "default": "Alt+Shift+H" },
      "description": "Show or hide the breadcrumb"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{81f5643b-abb8-4868-9aae-6ba042f40208}",
      "strict_min_version": "115.0"
    }
  }
}
